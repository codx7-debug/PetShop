# Physical iPhone / Android: MUST use your computer's Wi-Fi IPv4 (not localhost).
# Use the backend port from PetShop/backend (.env PORT or default 3000). No trailing slash, no /api.
# Windows: ipconfig → find IPv4 under your active adapter.
# Mac: System Settings → Network → Wi-Fi → Details → IP Address
#
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# iOS Simulator on the same Mac as the API can use localhost below.
EXPO_PUBLIC_API_URL=http://localhost:3000
